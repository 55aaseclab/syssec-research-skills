domain SysSecResearch version "0.1.3"
title "Systems Security Research"
description "A full-lifecycle systems security research workflow pack with explicit evidence, authorization, reproducibility, and publication gates."
category "Research"
accent "green"

port IntakeResearch version "1.0.0" {
  in {
    brief: String
    authorization: String?
  }
  out { result: String }
  effect ffi
}

port ScopeResearch version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port SurveyLiterature version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port DefineBaseline version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port IntakeArtifact version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect read
}

port DesignMethod version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port PrototypeSystem version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect write
}

port UnderstandTarget version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect read
}

port ReverseEngineer version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect read
}

port StaticAnalyze version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect read
}

port DynamicAnalyze version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port RunFuzzing version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port ValidateExploit version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect human
}

port PrototypeDefense version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect write
}

port ReproduceStudy version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port DesignExperiment version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port EvaluateStudy version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port MeasurePerformance version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port CheckCompatibility version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port AnalyzeStatistics version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port AssessValidity version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port SynthesizeEvidence version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect ffi
}

port WriteRelatedWork version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect write
}

port WriteResearch version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect write
}

port SubmitResearch version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect human
}

port DiscloseFinding version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect human
}

port EvaluateArtifact version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect read
}

port MaintainResearch version "1.0.0" {
  in { brief: String }
  out { result: String }
  effect write
}

port ReviewPlan version "1.0.0" {
  in { result: String }
  out { approved: Boolean }
  effect human
}

flow IdeaToPaper title "从想法到论文" create {
  description "从研究想法开始，经过 scope、证据、方法、评估和投稿。"
  input { brief: String required label "研究想法" placeholder "例如：研究隔离运行时在故障恢复中的安全边界" }
  needs { IntakeResearch, ScopeResearch, SurveyLiterature, DefineBaseline, IntakeArtifact, DesignMethod, PrototypeSystem, EvaluateStudy, SynthesizeEvidence, WriteResearch, SubmitResearch, MaintainResearch, ReviewPlan }
  steps {
    intake "研究接收" { uses { brief } call IntakeResearch output { result: String } }
    scope "问题与边界" { uses { result } call ScopeResearch output { result: String } }
    survey "文献梳理" { uses { result } call SurveyLiterature output { result: String } }
    baseline "基线定义" { uses { result } call DefineBaseline output { result: String } }
    artifacts "工件接收" { uses { result } call IntakeArtifact output { result: String } }
    method "方法设计" { uses { result } call DesignMethod output { result: String } }
    prototype "原型实现" { uses { result } call PrototypeSystem output { result: String } }
    evaluation "实验评估" { uses { result } call EvaluateStudy output { result: String } }
    synthesis "证据综合" { uses { result } call SynthesizeEvidence output { result: String } }
    writing "论文写作" { uses { result } call WriteResearch output { result: String } }
    submission "投稿准备" { uses { result } call SubmitResearch output { result: String } }
    maintenance "后续维护" { uses { result } call MaintainResearch output { result: String } }
    review "人工确认" { uses { result } call ReviewPlan output { approved: Boolean } }
  }
  output {
    result: String from result
    approved: Boolean from approved
  }
  ui { layout wizard primary "开始研究" icon "rocket" }
}

flow PaperReproduction title "论文复现" create {
  description "复现已有论文或 artifact，并记录偏差、实验设计和有效性威胁。"
  input { brief: String required label "复现目标" placeholder "例如：复现某篇论文中的核心实验并审计偏差" }
  needs { IntakeResearch, SurveyLiterature, IntakeArtifact, ReproduceStudy, DesignExperiment, EvaluateStudy, AssessValidity, WriteResearch, ReviewPlan }
  steps {
    intake "研究接收" { uses { brief } call IntakeResearch output { result: String } }
    survey "论文理解" { uses { result } call SurveyLiterature output { result: String } }
    artifacts "工件清点" { uses { result } call IntakeArtifact output { result: String } }
    reproduction "复现实验" { uses { result } call ReproduceStudy output { result: String } }
    design "实验设计" { uses { result } call DesignExperiment output { result: String } }
    evaluation "结果评估" { uses { result } call EvaluateStudy output { result: String } }
    validity "有效性威胁" { uses { result } call AssessValidity output { result: String } }
    writing "复现报告" { uses { result } call WriteResearch output { result: String } }
    review "人工确认" { uses { result } call ReviewPlan output { approved: Boolean } }
  }
  output {
    result: String from result
    approved: Boolean from approved
  }
  ui { layout wizard primary "开始复现" icon "scroll-text" }
}

flow LiteratureReview title "文献综述" create {
  description "收敛综述问题，梳理 related work，形成比较维度和综述写作。"
  input { brief: String required label "综述问题" placeholder "例如：比较不同系统隔离机制的故障模型与恢复保证" }
  needs { IntakeResearch, ScopeResearch, SurveyLiterature, DefineBaseline, SynthesizeEvidence, WriteRelatedWork, WriteResearch, SubmitResearch, ReviewPlan }
  steps {
    intake "研究接收" { uses { brief } call IntakeResearch output { result: String } }
    scope "综述边界" { uses { result } call ScopeResearch output { result: String } }
    survey "系统梳理" { uses { result } call SurveyLiterature output { result: String } }
    baseline "比较基线" { uses { result } call DefineBaseline output { result: String } }
    synthesis "证据综合" { uses { result } call SynthesizeEvidence output { result: String } }
    related "相关工作" { uses { result } call WriteRelatedWork output { result: String } }
    writing "综述写作" { uses { result } call WriteResearch output { result: String } }
    submission "投稿准备" { uses { result } call SubmitResearch output { result: String } }
    review "人工确认" { uses { result } call ReviewPlan output { approved: Boolean } }
  }
  output {
    result: String from result
    approved: Boolean from approved
  }
  ui { layout wizard primary "开始综述" icon "search" }
}

flow SystemAttackStudy title "系统攻击研究" create {
  description "在明确授权边界后分析系统攻击面、验证路径并整理披露材料。"
  input { brief: String required label "研究目标" placeholder "例如：分析一个已授权测试系统的攻击面" }
  input { authorization: String required label "授权边界" placeholder "说明测试范围、授权主体和禁止动作" }
  needs { IntakeResearch, ScopeResearch, UnderstandTarget, ReverseEngineer, StaticAnalyze, DynamicAnalyze, RunFuzzing, ValidateExploit, EvaluateStudy, SynthesizeEvidence, WriteResearch, DiscloseFinding, ReviewPlan }
  steps {
    intake "研究接收" { uses { brief, authorization } call IntakeResearch output { result: String } }
    scope "授权与范围" { uses { result } call ScopeResearch output { result: String } }
    target "目标理解" { uses { result } call UnderstandTarget output { result: String } }
    reverse "逆向分析" { uses { result } call ReverseEngineer output { result: String } }
    static "静态分析" { uses { result } call StaticAnalyze output { result: String } }
    dynamic "动态分析" { uses { result } call DynamicAnalyze output { result: String } }
    fuzzing "模糊测试" { uses { result } call RunFuzzing output { result: String } }
    exploit "漏洞验证" { uses { result } call ValidateExploit output { result: String } }
    evaluation "安全评估" { uses { result } call EvaluateStudy output { result: String } }
    synthesis "证据综合" { uses { result } call SynthesizeEvidence output { result: String } }
    writing "研究写作" { uses { result } call WriteResearch output { result: String } }
    disclosure "责任披露" { uses { result } call DiscloseFinding output { result: String } }
    review "人工确认" { uses { result } call ReviewPlan output { approved: Boolean } }
  }
  output {
    result: String from result
    approved: Boolean from approved
  }
  ui { layout wizard primary "开始攻击研究" icon "shield-alert" }
}

flow DefenseDesignStudy title "防御设计研究" create {
  description "从研究问题和基线出发设计防御，并评估安全、性能、兼容性和威胁。"
  input { brief: String required label "防御目标" placeholder "例如：设计一个降低隔离逃逸风险的防御机制" }
  needs { IntakeResearch, ScopeResearch, SurveyLiterature, DefineBaseline, UnderstandTarget, DesignMethod, PrototypeDefense, EvaluateStudy, MeasurePerformance, CheckCompatibility, AssessValidity, WriteResearch, SubmitResearch, ReviewPlan }
  steps {
    intake "研究接收" { uses { brief } call IntakeResearch output { result: String } }
    scope "问题与范围" { uses { result } call ScopeResearch output { result: String } }
    survey "相关工作" { uses { result } call SurveyLiterature output { result: String } }
    baseline "基线定义" { uses { result } call DefineBaseline output { result: String } }
    target "目标理解" { uses { result } call UnderstandTarget output { result: String } }
    method "防御方法" { uses { result } call DesignMethod output { result: String } }
    prototype "防御原型" { uses { result } call PrototypeDefense output { result: String } }
    evaluation "安全评估" { uses { result } call EvaluateStudy output { result: String } }
    performance "性能评估" { uses { result } call MeasurePerformance output { result: String } }
    compatibility "兼容性" { uses { result } call CheckCompatibility output { result: String } }
    validity "有效性威胁" { uses { result } call AssessValidity output { result: String } }
    writing "研究写作" { uses { result } call WriteResearch output { result: String } }
    submission "投稿准备" { uses { result } call SubmitResearch output { result: String } }
    review "人工确认" { uses { result } call ReviewPlan output { approved: Boolean } }
  }
  output {
    result: String from result
    approved: Boolean from approved
  }
  ui { layout wizard primary "设计防御" icon "key" }
}

